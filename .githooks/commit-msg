#!/bin/sh
# Rejects AI attribution in commit messages: Co-Authored-By trailers naming Claude or
# Anthropic, and "Generated with Claude Code" lines. Commits here are authored by Miguel.
# Enable per clone:  git config core.hooksPath .githooks
set -e

if grep -qiE '^co-authored-by:.*(claude|anthropic)|generated with.*claude' "$1"; then
    echo "commit-msg: AI attribution found in the commit message; remove it and commit again" >&2
    exit 1
fi
