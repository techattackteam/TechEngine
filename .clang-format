# TechEngine formatting (ADR-005: checked in, CI-enforced). Naming is NOT a
# clang-format concern (see .clang-tidy / CONVENTIONS.md).
---
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 280
NamespaceIndentation: All
FixNamespaceComments: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: None
AlignEscapedNewlines: Left
# All-or-nothing wrapping: a call/decl that overflows ColumnLimit puts every
# argument on its own line instead of packing them. AlwaysBreak is load-bearing
# here, not cosmetic: under the default Align, the continuation starts at the
# open-paren column, so AllowAllArgumentsOnNextLine never fits and every overflow
# explodes one-per-line.
BinPackArguments: false
BinPackParameters: false
AlignAfterOpenBracket: AlwaysBreak

# LLVM defaults that disagree with the CLion scheme this codebase was written in.
AccessModifierOffset: -4
IndentCaseLabels: true
SpaceAfterTemplateKeyword: false
SpaceBeforeRangeBasedForLoopColon: false
# CLion's BREAK_TEMPLATE_DECLARATION=LINE_BREAK. LLVM's MultiLine only breaks when the
# declaration below already wraps, so short templates got pulled onto one line.
# Spelled the pre-19 way on purpose: clang-format 19 renamed it BreakTemplateDeclarations
# but still accepts this, and CLion's bundled binary may be older.
AlwaysBreakTemplateDeclarations: Yes

SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeIsMainRegex: '(Tests)?$'
# GOTCHA: the FIRST matching regex wins, so the '.*' catch-all must stay LAST or it
# swallows every row below it. Reads out of priority order on purpose — that is match
# order, not sort order.
# The catch-all means "ours, module-private": a header reached through a target's PRIVATE
# src dir, e.g. <diagnostics/FormatBuffer.hpp>. Third-party is enumerated above it because
# the two are the same shape, a lowercase root plus a path. A new dependency that is not
# added to that row sorts as ours, and the format gate stays green while it does.
IncludeCategories:
  - Regex: '^<TechEngine/'                                             # ours: public API
    Priority: 1
  - Regex: '^<(GLFW|Jolt|catch2|glm|miniaudio|spdlog|toml\+\+|tracy)/' # third-party
    Priority: 3
  - Regex: '^<[a-z_]+>$'                                               # std: one lowercase word, no slash or dot
    Priority: 4
  - Regex: '.*'                                                        # ours: module-private
    Priority: 2
